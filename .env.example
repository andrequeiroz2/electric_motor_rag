# Copie para `.env` na raiz do repositório e preencha os valores.
#   cp .env.example .env
# Referência: docs/Settings.md (CLI/RAG) e docs/MCP.md (servidor MCP).

# --- Obrigatório para `answer` (LLM) ---
OPENAI_API_KEY=

# --- Cliente MCP no `answer` (opcional) ---
# Com URL definida, o answer chama tools HTTP; servidor indisponível → erro explícito.
# MCP_HTTP_URL=http://127.0.0.1:8000/mcp

# --- Qdrant ---
# QDRANT_URL=http://localhost:6333
# QDRANT_COLLECTION=eletric_motor

# --- Redis / cache ---
# REDIS_URL=redis://localhost:6379
# CACHE_ENABLED=true
# CACHE_TTL_S=86400

# --- LLM ---
# LLM_MODEL=gpt-4o
# LLM_CONTEXT_TOKENS=12000

# --- Embeddings e reranker (fastembed) ---
# MODEL_CACHE_DIR=~/.cache/fastembed
# EMBEDDING_THREADS=
# RERANKER_MODEL=jinaai/jina-reranker-v2-base-multilingual
# RERANK_CANDIDATES=24

# --- Vetores (só altere se recriar a coleção) ---
# DENSE_VECTOR_NAME=dense
# SPARSE_VECTOR_NAME=sparse
# DENSE_SIZE=1024

# --- Servidor MCP (`uv run --directory mcp eletric-motor-mcp`) ---
# O pacote MCP lê `.env` do diretório de trabalho; com `--directory mcp`, use `mcp/.env`
# ou exporte estas variáveis. Não precisa de OPENAI_API_KEY no servidor.
# MCP_HOST=127.0.0.1
# MCP_PORT=8000
# MCP_PATH=/mcp
# MCP_TRANSPORT=streamable-http
# MCP_LOG_LEVEL=INFO
